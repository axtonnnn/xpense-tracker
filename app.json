{
  "expo": {
    "name": "Xpense",
    "slug": "xpense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xpense",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F4EE",
    "ios": {
      "bundleIdentifier": "com.axtonnnn.xpense",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Xpense"
      },
      "icon": "./assets/xpense.icon"
    },
    "android": {
      "package": "com.axtonnnn.xpense",
      "adaptiveIcon": {
        "backgroundColor": "#1E5B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0F1A17",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Xpense uses the camera so you can scan receipts and bills.",
          "photosPermission": "Xpense opens your photos so you can choose a receipt or bill to scan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Xpense uses Face ID to keep your money data locked."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "",
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": "",
      "privacyUrl": "",
      "termsUrl": ""
    }
  }
}
