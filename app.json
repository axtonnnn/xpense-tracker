{
  "expo": {
    "name": "Xpense",
    "slug": "xpense",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "xpense",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3EF",
    "ios": {
      "bundleIdentifier": "com.axtonnnn.xpense",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Xpense",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "icon": "./assets/xpense.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.axtonnnn.xpense",
      "adaptiveIcon": {
        "backgroundColor": "#F4F3EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Xpense uses the camera so you can scan receipts and bills.",
          "photosPermission": "Xpense opens your photos so you can choose a receipt or bill to scan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Xpense uses Face ID to keep your money private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "",
      "supabaseUrl": "",
      "supabaseKey": "",
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": "",
      "privacyUrl": "",
      "termsUrl": ""
    }
  }
}
